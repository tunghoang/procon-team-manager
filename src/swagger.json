{
  "swagger": "2.0",
  "info": {
    "title": "Procon"
  },
  "basePath": "/api",
  "paths": {
    "/question": {
      "get": {
        "summary": "Get all questions",
        "tags": [
          "Question"
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Question"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/question/{id}": {
      "get": {
        "summary": "Get a question",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of question",
            "required": true,
            "type": "integer"
          }
        ],
        "tags": [
          "Question"
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "$ref": "#/definitions/Question"
            }
          },
          "404": {
            "description": "Not found"
          },
          "405": {
            "description": "Not allowed"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/question/bulk-create": {
      "post": {
        "summary": "Create several questions in one request (ADMIN ONLY)",
        "description": "ALL-OR-NOTHING: the first failure rolls back every question row AND deletes every engine game the request had already created, so either all of them exist or none do. Entries come in two interchangeable shapes. FLAT -- paste a /game/init board straight into the entry and just add `name`. NESTED -- put the board under `raw_questions`, exactly the single-create body. Question fields given at the top level (or in `defaults`) apply to every entry; per-entry values win. Any `game_id` inside a board is ignored: the question's own id becomes the engine game id. Max 50 entries per request.",
        "tags": [
          "Question"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "questions"
              ],
              "properties": {
                "match_id": {
                  "type": "integer",
                  "description": "Default match for every entry; an entry may override it."
                },
                "defaults": {
                  "type": "object",
                  "description": "Question fields merged into every entry. May also carry a shared `raw_questions` when several questions reuse one board."
                },
                "questions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": {
                    "$ref": "#/definitions/BulkQuestionEntry"
                  }
                }
              },
              "default": {
                "match_id": 1,
                "questions": [
                  {
                    "name": "Round 1",
                    "startsAt": 1785204000,
                    "daySeconds": [
                      45,
                      45,
                      45,
                      45
                    ],
                    "daySteps": [
                      55,
                      110,
                      87,
                      61
                    ],
                    "map": {
                      "height": 20,
                      "width": 20,
                      "cells": []
                    },
                    "spots": [
                      {
                        "brand": 4,
                        "pos": 241,
                        "stocks": 4
                      }
                    ],
                    "fuelLimits": 118,
                    "players": 2,
                    "busyThreshold": 3,
                    "jammedThreshold": 8,
                    "teams": [
                      {
                        "team_id": 1,
                        "agents": [
                          79,
                          212,
                          47,
                          324
                        ]
                      }
                    ],
                    "agent_selection_time_limit": 45
                  },
                  {
                    "name": "Round 2",
                    "raw_questions": {}
                  }
                ]
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Every question was created",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "created_count": {
                  "type": "integer"
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Question"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Pre-flight rejection, naming the entry: empty/oversized list, missing name, no board, or a duplicated name (within the batch or against a stored question). Nothing was created.",
            "schema": {
              "$ref": "#/definitions/BulkCreateError"
            }
          },
          "406": {
            "description": "An entry has no match_id. Nothing was created.",
            "schema": {
              "$ref": "#/definitions/BulkCreateError"
            }
          },
          "422": {
            "description": "The game service rejected a board (its own status is forwarded, not masked as 500). Everything was rolled back.",
            "schema": {
              "$ref": "#/definitions/BulkCreateError"
            }
          },
          "405": {
            "description": "Not allowed (admin required)"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/answer": {
      "get": {
        "summary": "Get all answers",
        "tags": [
          "Answer"
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Answer"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Create and Edit your answer",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": false,
            "schema": {
              "type": "object",
              "properties": {
                "question_id": {
                  "type": "integer"
                },
                "answer_data": {
                  "type": "object",
                  "default": {
                    "ops": [
                      {
                        "x": 5,
                        "y": 6,
                        "n": 2
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
        "tags": [
          "Answer"
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Client error"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/answer/{id}": {
      "get": {
        "summary": "Get your answer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of answer",
            "required": true,
            "type": "integer"
          }
        ],
        "tags": [
          "Answer"
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "$ref": "#/definitions/Answer"
            }
          },
          "404": {
            "description": "Not found"
          },
          "405": {
            "description": "Not allowed"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/team": {
      "get": {
        "summary": "Get your team",
        "tags": [
          "Team"
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Team"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/group": {
      "get": {
        "summary": "List groups (schools)",
        "tags": [
          "Group"
        ],
        "description": "Superadmin: every group. Group manager: its own group only. Each row carries member_count, match_count and managers. Roles: superadmin (is_admin) is unscoped; a GROUP MANAGER (group_role=manager + group_id, a dedicated non-playing account) is confined to its own group; a team sees only what it is rostered on.",
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Group"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Not staff (superadmin or group manager)"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Create a group (SUPERADMIN)",
        "tags": [
          "Group"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Missing or duplicated name"
          },
          "405": {
            "description": "Not superadmin"
          }
        }
      }
    },
    "/group/{id}": {
      "get": {
        "summary": "Get one group (staff of that group)",
        "tags": [
          "Group"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group id"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "$ref": "#/definitions/Group"
            }
          },
          "404": {
            "description": "Not found / not your group"
          }
        }
      },
      "put": {
        "summary": "Rename a group (SUPERADMIN)",
        "tags": [
          "Group"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group id"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Duplicated name"
          },
          "405": {
            "description": "Not superadmin"
          }
        }
      },
      "delete": {
        "summary": "Delete a group (SUPERADMIN)",
        "tags": [
          "Group"
        ],
        "description": "The group's accounts and matches are kept and dropped back to 'no group' (group_id NULL, group_role member).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group id"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          },
          "405": {
            "description": "Not superadmin"
          }
        }
      }
    },
    "/group/{id}/members": {
      "get": {
        "summary": "Accounts in the group",
        "tags": [
          "Group"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group id"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/GroupMember"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Not staff (superadmin or group manager)"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Add accounts to the group",
        "tags": [
          "Group"
        ],
        "description": "All-or-nothing. A group manager may add only UNGROUPED, non-admin accounts to its own group; the superadmin may move any account. Added accounts become plain members (the manager role is set via PUT /team/{id}).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group id"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "team_ids"
              ],
              "properties": {
                "team_ids": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Added",
            "schema": {
              "type": "object",
              "properties": {
                "group_id": {
                  "type": "integer"
                },
                "added_count": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "No team_ids / a superadmin account"
          },
          "403": {
            "description": "Account already in another group, or not yours to add"
          },
          "404": {
            "description": "Group or team not found"
          }
        }
      }
    },
    "/group/{id}/candidates": {
      "get": {
        "summary": "Accounts that could be added to the group",
        "tags": [
          "Group"
        ],
        "description": "Group manager: the ungrouped, non-admin accounts. Superadmin: every account outside this group (group_id shows where it currently is).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group id"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully",
            "schema": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/GroupCandidate"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Not staff (superadmin or group manager)"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/group/{id}/members/{teamId}": {
      "delete": {
        "summary": "Remove an account from the group",
        "tags": [
          "Group"
        ],
        "description": "Back to 'no group'. A manager may remove its own members but never itself.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group id"
          },
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Removed"
          },
          "403": {
            "description": "A manager removing itself"
          },
          "404": {
            "description": "Team is not in this group"
          }
        }
      }
    }
  },
  "consumes": [
    "application/json"
  ],
  "securityDefinitions": {
    "token": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "The RAW JWT from the team-manager login -- do NOT prefix it with 'Bearer'. middleware/authenticate.js reads the Authorization header verbatim and hands it straight to jwt.verify, so a 'Bearer ' prefix fails to parse. (The HEXUDON game service is the opposite and does want 'Bearer '.)"
    }
  },
  "security": [
    {
      "token": []
    }
  ],
  "definitions": {
    "Team": {
      "required": [
        "name",
        "account"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "group_id": {
          "type": "integer",
          "x-nullable": true,
          "description": "Group (school) the account belongs to; null = none"
        },
        "group_role": {
          "type": "string",
          "enum": [
            "member",
            "manager"
          ],
          "description": "manager = runs its group's matches (scoped admin)"
        }
      }
    },
    "Match": {
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "start_time": {
          "type": "string",
          "format": "datetime"
        },
        "end_time": {
          "type": "string",
          "format": "datetime"
        },
        "is_active": {
          "type": "boolean"
        }
      }
    },
    "Question": {
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "question_data": {
          "type": "string"
        },
        "match_id": {
          "type": "integer"
        },
        "match": {
          "type": "object",
          "properties": {
            "schema": {
              "$ref": "#/definitions/Match"
            }
          }
        }
      }
    },
    "BulkQuestionEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "One question. Either put the /game/init board under `raw_questions`, or -- the flat form -- spread its fields (startsAt, daySeconds, daySteps, map, spots, fuelLimits, players, busyThreshold, jammedThreshold, teams, agent_selection_time_limit) directly here alongside `name`. Any key that is not one of the question's own columns is treated as board data, so `name` can never leak into the stored board.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique within the match."
        },
        "description": {
          "type": "string"
        },
        "match_id": {
          "type": "integer",
          "description": "Overrides the request-level default."
        },
        "raw_questions": {
          "type": "object",
          "description": "The full /game/init body. Omit when using the flat form."
        }
      },
      "additionalProperties": true
    },
    "BulkCreateError": {
      "properties": {
        "message": {
          "type": "string",
          "description": "The reason. For a board rejection this is the game service's own error body verbatim."
        },
        "failed_index": {
          "type": "integer",
          "description": "Index in `questions` of the entry that failed; null when the request failed before the create loop."
        },
        "failed_name": {
          "type": "string",
          "description": "That entry's name."
        },
        "created_count": {
          "type": "integer",
          "description": "Always 0 -- the batch is all-or-nothing."
        },
        "rolled_back_games": {
          "type": "integer",
          "description": "How many engine games had already been created and were deleted again."
        }
      }
    },
    "Answer": {
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "answer_data": {
          "type": "string"
        },
        "score_data": {
          "type": "string"
        },
        "team_id": {
          "type": "integer"
        },
        "match_id": {
          "type": "integer"
        },
        "question_id": {
          "type": "integer"
        }
      }
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "member_count": {
          "type": "integer"
        },
        "match_count": {
          "type": "integer"
        },
        "managers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "GroupMember": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "group_role": {
          "type": "string",
          "enum": [
            "member",
            "manager"
          ]
        },
        "is_admin": {
          "type": "boolean"
        }
      }
    },
    "GroupCandidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "account": {
          "type": "string"
        },
        "group_id": {
          "type": "integer",
          "x-nullable": true,
          "description": "null = ungrouped"
        }
      }
    }
  }
}
